# PostgreSQL with pgvector Configuration
POSTGRES_DB=intelli_meeting
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Neo4j Graph Database Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password123

# Embedding Configuration
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIMENSION=1024

# LLM API Configuration (OpenAI-compatible endpoint; default is local Ollama)
# Ollama does not authenticate local requests, but the client requires a non-empty key.
LLM_API_KEY=local-placeholder
LLM_MODEL=gemma3:4b
LLM_BASE_URL=http://localhost:11434/v1
# Local models are slow on CPU (a chunk can take minutes), and gemma3 on Ollama returns "{}" in JSON mode.
LLM_TIMEOUT_SECONDS=600
LLM_JSON_MODE=false
# For OpenAI instead (keep LLM_TIMEOUT_SECONDS=60 and LLM_JSON_MODE=true): LLM_BASE_URL=https://api.openai.com/v1, LLM_MODEL=gpt-4o-mini, and a real LLM_API_KEY

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

